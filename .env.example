# Copia a .env y llena los valores desde Firebase Console:
# Configuracion del proyecto (engranaje) > Tus apps > Configuracion de la app.
# Estos valores NO son secretos (config publica del SDK web); la seguridad
# depende de firestore.rules, no de ocultarlos. Aun asi, .env esta en .gitignore.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=tu-dia-ea0fd.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu-dia-ea0fd
VITE_FIREBASE_STORAGE_BUCKET=tu-dia-ea0fd.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Push (FCM): Console > Configuracion > Cloud Messaging > Certificados de envio web.
# Solo necesario cuando se active push. La clave VAPID es publica por diseno.
VITE_FCM_VAPID_KEY=
