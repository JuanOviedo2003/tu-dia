rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isHash(value) {
      return value is string && value.size() == 64;
    }

    function roomPath(roomId) {
      return /databases/$(database)/documents/rooms/$(roomId);
    }

    function keysPath(roomId) {
      return /databases/$(database)/documents/roomKeys/$(roomId);
    }

    function hasClaim(roomId, role, tokenHash) {
      let claimPath = /databases/$(database)/documents/roomAccess/$(roomId + '_' + request.auth.uid);
      return isHash(tokenHash)
        && exists(claimPath)
        && get(claimPath).data.role == role
        && get(claimPath).data.proof == tokenHash
        && get(claimPath).data.get('revoked', false) != true;
    }

    function isRoomOwner(roomId) {
      return exists(roomPath(roomId))
        && get(roomPath(roomId)).data.ownerUid == request.auth.uid;
    }

    function isRoomEditor(roomId) {
      let keys = keysPath(roomId);
      return (exists(keys) && hasClaim(roomId, 'editor', get(keys).data.get('editTokenHash', null)))
        || (!exists(keys) && exists(roomPath(roomId)) && hasClaim(roomId, 'editor', get(roomPath(roomId)).data.get('editTokenHash', null)));
    }

    function isRoomManager(roomId) {
      return isRoomOwner(roomId) || isRoomEditor(roomId);
    }

    match /roomAccess/{claimId} {

      function claimRoom() {
        return claimId.split('_')[0];
      }

      function isSelf() {
        return request.auth != null && request.auth.uid == claimId.split('_')[1];
      }

      function validSelfClaim() {
        let d = request.resource.data;
        return d.role in ['editor', 'viewer']
          && d.proof is string
          && d.proof.size() == 64
          && !d.keys().hasAny(['revoked'])
          && (
            (d.role == 'editor'
              && d.keys().hasOnly(['role', 'proof', 'roomId'])
              && d.get('roomId', claimRoom()) == claimRoom())
            || (d.role == 'viewer'
              && d.keys().hasOnly(['role', 'proof', 'roomId', 'name', 'joinedAt'])
              && d.get('roomId', null) == claimRoom()
              && d.get('name', null) is string
              && d.name.size() <= 40
              && d.name.matches('(?s).*\\S.*')
              && (d.get('joinedAt', null) is number || d.get('joinedAt', null) is timestamp))
          );
      }

      function isManagerRevoke() {
        return request.auth != null
          && resource.data.role == 'viewer'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revoked'])
          && request.resource.data.revoked == true
          && isRoomManager(claimRoom());
      }

      allow create: if isSelf() && validSelfClaim();

      allow update: if (isSelf() && resource.data.get('revoked', false) != true && validSelfClaim())
        || isManagerRevoke();

      allow read: if isSelf();

      allow list: if request.auth != null
        && resource.data.role == 'viewer'
        && isRoomManager(resource.data.roomId);

      allow delete: if request.auth != null
        && (
          get(/databases/$(database)/documents/rooms/$(claimRoom())).data.ownerUid == request.auth.uid
          || (resource.data.role == 'viewer' && isRoomEditor(claimRoom()))
        );
    }

    match /roomKeys/{roomId} {

      function hasValidKeys() {
        return request.resource.data.keys().hasOnly(['editTokenHash', 'viewTokenHash'])
          && isHash(request.resource.data.get('editTokenHash', null))
          && isHash(request.resource.data.get('viewTokenHash', null));
      }

      allow read: if false;

      allow create: if request.auth != null
        && hasValidKeys()
        && (
          (existsAfter(roomPath(roomId)) && getAfter(roomPath(roomId)).data.ownerUid == request.auth.uid)
          || (exists(roomPath(roomId)) && hasClaim(roomId, 'editor', get(roomPath(roomId)).data.get('editTokenHash', null)))
        );

      allow update: if request.auth != null
        && hasValidKeys()
        && (isRoomOwner(roomId) || hasClaim(roomId, 'editor', resource.data.editTokenHash));

      allow delete: if request.auth != null
        && isRoomOwner(roomId);
    }

    match /rooms/{roomId} {

      function isValidClaim(role, field) {
        let keys = keysPath(roomId);
        return (exists(keys) && hasClaim(roomId, role, get(keys).data.get(field, null)))
          || (!exists(keys) && hasClaim(roomId, role, resource.data.get(field, null)));
      }

      function onlyRemoves(changed, field) {
        return !changed.hasAny([field]) || !request.resource.data.keys().hasAny([field]);
      }

      function isValidEditorUpdate() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        return !changed.hasAny(['ownerUid'])
          && onlyRemoves(changed, 'editTokenHash')
          && onlyRemoves(changed, 'viewTokenHash');
      }

      function validOwnerName() {
        let d = request.resource.data;
        return !d.keys().hasAny(['ownerName'])
          || (d.ownerName is string && d.ownerName.size() <= 40 && d.ownerName.matches('(?s).*\\S.*'));
      }

      allow read: if request.auth != null
        && (
          resource.data.ownerUid == request.auth.uid
          || isValidClaim('editor', 'editTokenHash')
          || isValidClaim('viewer', 'viewTokenHash')
        );

      allow create: if request.auth != null
        && validOwnerName()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.tasks is list
        && request.resource.data.tasks.size() <= 500
        && request.resource.data.tombstones is map
        && request.resource.data.tombstones.size() <= 600;

      allow update: if request.auth != null
        && validOwnerName()
        && request.resource.data.tasks is list
        && request.resource.data.tasks.size() <= 500
        && request.resource.data.tombstones is map
        && request.resource.data.tombstones.size() <= 600
        && (
          resource.data.ownerUid == request.auth.uid
          || (isValidClaim('editor', 'editTokenHash') && isValidEditorUpdate())
        );

      allow delete: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;
    }
  }
}
